# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=delguur_db
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS — production дээр frontend-ийн бүтэн URL (https)
CLIENT_URL=https://your-shop-domain.com

# Upload (413 гарвал Nginx `client_max_body_size`-ийг энэхүү хэмжээнээс багагүй болгоно)
UPLOAD_DIR=uploads
# Зургийн дээд хэмжээ (MB, дээд 100), эсвэл шууд байтаар MAX_FILE_SIZE
UPLOAD_MAX_FILE_MB=25
# MAX_FILE_SIZE=26214400
# Upload дараа resize + WebP шахалт (svg/gif-ийг өөрчлөхгүй)
IMAGE_MAX_DIMENSION=2560
IMAGE_WEBP_QUALITY=82
