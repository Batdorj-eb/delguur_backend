# Server
PORT=5000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=delguur_db
DB_USER=postgres
DB_PASSWORD=your_strong_password_here

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# CORS — production дээр frontend-ийн бүтэн URL (https)
CLIENT_URL=https://your-shop-domain.com

# Upload
UPLOAD_DIR=uploads
MAX_FILE_SIZE=5242880
